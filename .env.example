# ============================================================
#  NovaDL — All-in-One Video Downloader · Environment
#  Copy to `.env` locally, or set as Render env vars.
#  NEVER commit a real `.env`.
# ============================================================

# ---- Telegram bot (REQUIRED for the bot worker) ----
BOT_TOKEN=123456789:AAA_your_bot_token_here

# ---- Owner (admin) Telegram user id ----
OWNER_ID=6097891113

# ---- Optional limits / controls ----
# MAX_FILE_SIZE=188743680          # web download cap in bytes (default 180 MB)
# ALLOWED_USERS=                   # comma-separated telegram ids (empty = allow all)
# YTDLP_UPDATE_INTERVAL=86400      # self-update interval in seconds (default daily)

# ---- Optional durable storage (Render disk) ----
# DATA_DIR=/var/data/novadl
